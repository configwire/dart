{
  "_comment": "ConfigWire T17 e2e seed: project/env/2 groups/4 typed flags (one of EACH type)/2 rules (platform + semver)/1 running 50/50 experiment. Field names mirror server/migrations/1787875200_init_configwire.go exactly.",
  "project": { "name": "e2e-proj", "owner": "e2e" },
  "env": { "slug": "e2e" },
  "groups": [{ "name": "core" }, { "name": "growth" }],
  "flags": [
    {
      "key": "welcome_text",
      "type": "string",
      "default": "hello",
      "group": "core"
    },
    { "key": "max_items", "type": "number", "default": 10, "group": "core" },
    {
      "key": "exp_bool",
      "type": "bool",
      "default": false,
      "group": "growth"
    },
    {
      "key": "home_config",
      "type": "json",
      "default": { "a": 1 },
      "group": "growth"
    }
  ],
  "rules": [
    {
      "flag": "welcome_text",
      "priority": 10,
      "condition": { "field": "platform", "op": "==", "value": "ios" },
      "value": "ios-hello"
    },
    {
      "flag": "max_items",
      "priority": 10,
      "condition": { "field": "appVersion", "op": ">=", "value": "2.0.0" },
      "value": 20
    }
  ],
  "experiment": {
    "name": "e2e-exp",
    "flag": "exp_bool",
    "seed": "e2e-seed-1",
    "status": "running",
    "variants": [
      {
        "name": "control",
        "weightBps": 5000,
        "values": { "exp_bool": false }
      },
      {
        "name": "treatment",
        "weightBps": 5000,
        "values": { "exp_bool": true }
      }
    ]
  },
  "sdkKey": { "rateLimit": 100000 },
  "fetchCtx": {
    "uid": "e2e-user-7",
    "platform": "ios",
    "appVersion": "2.1.0"
  },
  "v2BreakingChange": {
    "_comment": "stage 4 flips the rule-free json default so the fetch delta is unambiguous",
    "flag": "home_config",
    "from": { "a": 1 },
    "to": { "a": 2 }
  }
}
